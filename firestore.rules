rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the calling user is in this group's member list
    function isMember(groupId) {
      return request.auth != null &&
             request.auth.uid in get(/databases/$(database)/documents/v6_groups/$(groupId)).data.memberUids;
    }

    // User profile docs: only the user themselves can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /v6_groups/{groupId} {
      // Anyone authenticated can READ the root doc (needed to validate the room code before joining)
      allow read: if request.auth != null;

      // Anyone authenticated can CREATE a new group
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUids;

      // Only existing members can UPDATE group settings (room name, daysInMonth, etc.)
      // Also allow a non-member to join by adding themselves to memberUids (arrayUnion)
      allow update: if request.auth != null && (
        isMember(groupId) ||
        // Allow joining: the only change is adding the caller's uid to memberUids
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) &&
         request.auth.uid in request.resource.data.memberUids)
      );

      // Only the creator can delete a group
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;

      // All sub-collections: only members can read/write
      match /members/{docId} {
        allow read, write: if isMember(groupId);
      }

      match /customSplits/{docId} {
        allow read, write: if isMember(groupId);
      }

      match /months/{monthId} {
        allow read, write: if isMember(groupId);

        // Nested memberSnapshots sub-collection
        match /memberSnapshots/{memberId} {
          allow read, write: if isMember(groupId);
        }
      }

      match /ledger/{eventId} {
        // Members can read ledger; ledger entries are append-only (no updates or deletes)
        allow read: if isMember(groupId);
        allow create: if isMember(groupId);
        allow update, delete: if false; // Immutable!
      }
    }

    // Smart Inbox: per-user pending transactions (user can only access their own)
    match /pending_transactions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
